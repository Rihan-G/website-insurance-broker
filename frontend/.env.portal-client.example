# Copy to frontend/.env.portal-client (gitignored) for: pnpm build:portal-client
# Build mode portal-client also forces VITE_PORTAL_FLAVOR=client (see vite.config.ts).
# Same Supabase keys as the staff build; set URLs for your hosts.
# For deploying this as its own Cloudflare Pages project alongside the staff portal,
# see ../docs/CLOUDFLARE_PAGES_SPLIT_PORTALS.md.

VITE_PORTAL_FLAVOR=client
VITE_STAFF_PORTAL_URL=https://ops.example.com
VITE_CLIENT_PORTAL_URL=https://portal.example.com
