# Supabase — from Project Settings → API (or Connect in dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Prefer new publishable key (sb_publishable_…); otherwise use legacy anon JWT.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy name — same role as publishable key in most projects
VITE_SUPABASE_ANON_KEY=

# ── AI API keys (NEVER add VITE_* OpenAI / Anthropic keys — the browser bundle is public) ──
# Configure on the host only, e.g. Supabase Dashboard → Edge Functions → Secrets, or:
#   supabase secrets set AI_API_KEY_BROKER=sk-...
#   supabase secrets set AI_API_KEY_CLIENT=sk-...
# Optional OpenAI-compatible base (Azure, OpenRouter, etc.):
#   supabase secrets set OPENAI_BASE_URL=https://api.openai.com/v1
# Deploy the bundled function:  supabase functions deploy ai-config
