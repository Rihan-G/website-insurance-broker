# Supabase — from Project Settings → API (or Connect in dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Prefer new publishable key (sb_publishable_…); otherwise use legacy anon JWT.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy name — same role as publishable key in most projects
VITE_SUPABASE_ANON_KEY=

# GitHub Pages: add the same VITE_SUPABASE_* variables as repository Actions secrets so the
# "Deploy GitHub Pages" workflow bakes them into the static build. Optional secret:
# VITE_ALLOW_DEMO_LOGIN=true   (keep demo buttons alongside real Supabase)
# VITE_ALLOW_DEMO_LOGIN=false  (real keys only; no demo sign-in)

# Optional: set to "false" to hide the staff/administrator sign-in link on `/login` (staff still open `/admin` directly).
# VITE_SHOW_STAFF_LOGIN_LINK=false

# Optional: force demo quick sign-in on production/staging builds (default: off in prod; `pnpm dev` enables demo unless set to false).
# VITE_ALLOW_DEMO_LOGIN=true
# VITE_ALLOW_DEMO_LOGIN=false

# Optional demo credentials (defaults are sindicom-style addresses in demoAuth.ts).
# VITE_DEMO_CLIENT_EMAIL=
# VITE_DEMO_CLIENT_PASSWORD=

# --- Split portals (optional): two origins so clients and staff each keep their own Supabase session.
# Omit or use unified for a single app (default). Client host: VITE_PORTAL_FLAVOR=client + VITE_STAFF_PORTAL_URL.
# Staff host: VITE_PORTAL_FLAVOR=staff + VITE_CLIENT_PORTAL_URL. Same VITE_SUPABASE_* on both.
# VITE_PORTAL_FLAVOR=client
# VITE_STAFF_PORTAL_URL=https://ops.yourdomain.com
# VITE_CLIENT_PORTAL_URL=https://portal.yourdomain.com

# Optional GitHub links on Renewals (empty VITE_GITHUB_PR_COMPARE is ignored — do not set to blank).
# VITE_GITHUB_REPO_URL=https://github.com/your-org/your-repo
# VITE_GITHUB_PR_COMPARE=https://github.com/your-org/your-repo/compare/main...your-branch
