# Copy to frontend/.env.portal-staff (gitignored) for: pnpm build:portal-staff
# Build mode portal-staff forces VITE_PORTAL_FLAVOR=staff (see vite.config.ts).
# For deploying this as its own Cloudflare Pages project alongside the client portal,
# see ../docs/CLOUDFLARE_PAGES_SPLIT_PORTALS.md.

VITE_PORTAL_FLAVOR=staff
VITE_STAFF_PORTAL_URL=https://ops.example.com
VITE_CLIENT_PORTAL_URL=https://portal.example.com
